SITE_URL=http://localhost:3000
# Optional Search Console HTML-tag verification token (the content value only).
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Optional: use an existing Resend segment instead of creating one automatically.
RESEND_SEGMENT_ID=
NOTIFICATION_EMAIL=hello@terratora.com
EMAIL_FROM=Terratora <notifications@your-verified-domain.com>

# Used only by `npm run seed` to create/promote the initial CMS administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
